<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solo para LanguageTool (se puede apagar en la app). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Opcional: encender la burbuja desde el botón de ajustes rápidos sin entrar a Accesibilidad.
         Android solo lo concede por adb:
         adb shell pm grant com.davidsant7e.sacerdotisa android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="ProtectedPermissions" />

    <!-- Para elegir de la lista las apps de bancos (solo apps con ícono en el menú). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Tema">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Mantener presionado el ícono → «Enviar registro». -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/atajos_registro" />
        </activity>

        <!-- Menú «Explicar» al seleccionar texto en cualquier app -->
        <activity
            android:name=".ui.ExplicarActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/explicar"
            android:taskAffinity=""
            android:theme="@style/Tema.Dialogo">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- La burbuja: servicio de accesibilidad (solo el sistema puede conectarse a él) -->
        <service
            android:name=".servicio.SacerdotisaService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accesibilidad" />
        </service>

        <!-- Botón «Sacerdotisa» en los ajustes rápidos: apagarla antes de abrir el banco. -->
        <service
            android:name=".servicio.Mosaico"
            android:exported="true"
            android:icon="@drawable/ic_mosaico"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Registro (log) de la app: arranca solo con el proceso; se comparte desde el atajo del ícono. -->
        <provider
            android:name="com.davidsant7e.sacerdotisa.registro.RegistroInicio"
            android:authorities="${applicationId}.registro"
            android:exported="false"
            android:initOrder="1000" />
        <activity
            android:name="com.davidsant7e.sacerdotisa.registro.EnviarRegistroActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
